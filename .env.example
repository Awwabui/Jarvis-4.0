# Copy this file to .env and fill in your own keys.
# .env is gitignored, so your keys stay private.

# LiveKit config — https://cloud.livekit.io (Projects -> Settings -> API keys)
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_URL=wss://your-project.livekit.cloud

# Google Gemini API key — https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key

# Google Programmable Search Engine — https://programmablesearchengine.google.com + https://developers.google.com/custom-search/v1/overview
GOOGLE_SEARCH_API_KEY=your_google_search_api_key
SEARCH_ENGINE_ID=your_search_engine_id

# Weather API Key — https://openweathermap.org/api (free tier)
OPENWEATHER_API_KEY=your_openweather_api_key

# User location (used for accurate time + weather)
DEFAULT_CITY=Peshawar
USER_TIMEZONE=Asia/Karachi

# Browser profile: leave empty to auto-detect your Chrome/Edge profile
# (so Jarvis opens the browser WITH your logged-in account).
# Set a custom path here only if auto-detect picks the wrong one.
BROWSER_PROFILE_DIR=

# ── Jarvis v4.0 PRO tuning (all optional) ─────────────────────────────
# Remote-debugging port used to attach to your REAL Chrome/Edge
# (native logged-in account). Keep Chrome launched with
#   --remote-debugging-port=9222  (run: python setup_jarvis_chrome.py)
JARVIS_CDP_PORT=9222

# Set to 0 to disable CDP attach entirely (force profile launch)
JARVIS_CDP=1

# Realtime voice: Charon (default), Aoede, Kore, Puck, Zephyr, …
JARVIS_VOICE=Charon

# Gemini Live model override (leave empty for the plugin default):
#   gemini-live-2.5-flash-native-audio | gemini-2.5-flash-native-audio-preview-12-2025
#   gemini-3.1-flash-live-preview
JARVIS_LLM_MODEL=

# Realtime "thinking" budget. 0 = thinking OFF (fastest replies, recommended).
# -1 = model default. Higher values = smarter but slower.
JARVIS_THINKING_BUDGET=0
