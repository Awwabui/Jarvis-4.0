# Copy this file to .env and fill in your own keys.
# .env is gitignored, so your keys stay private.

# LiveKit config — https://cloud.livekit.io (Projects -> Settings -> API keys)
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_URL=wss://your-project.livekit.cloud

# Google Gemini API key — https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key

# Google Programmable Search Engine — https://programmablesearchengine.google.com + https://developers.google.com/custom-search/v1/overview
GOOGLE_SEARCH_API_KEY=your_google_search_api_key
SEARCH_ENGINE_ID=your_search_engine_id

# Weather API Key — https://openweathermap.org/api (free tier)
OPENWEATHER_API_KEY=your_openweather_api_key

# User location (used for accurate time + weather)
DEFAULT_CITY=Peshawar
USER_TIMEZONE=Asia/Karachi

# ── Screen awareness / vision ──────────────────────────────────────────
# Automatic background screen awareness (true/false). The explicit
# "take a screenshot" command works even when this is false.
SCREEN_AWARENESS=true
# Seconds between screen captures (lightweight local change check —
# vision API is only called when the screen changes significantly)
SCREEN_WATCH_INTERVAL=2
# Change-detection threshold (0-255 mean diff on a 96x54 downsampled
# frame; lower = more sensitive = more vision API calls)
SCREEN_CHANGE_THRESHOLD=8
# Vision model for image analysis (vision-capable; reuses GOOGLE_API_KEY)
# e.g. gemini-3.6-flash (current default), gemini-3.7-flash
VISION_MODEL=gemini-3.6-flash

# Browser profile: leave empty to auto-detect your Chrome/Edge profile
# (so Jarvis opens the browser WITH your logged-in account).
# Set a custom path here only if auto-detect picks the wrong one.
BROWSER_PROFILE_DIR=

# ── Jarvis v4.0 PRO tuning (all optional — unset = Gemini's smart default) ──
# Remote-debugging port used to attach to your REAL Chrome/Edge
# (native logged-in account). Keep Chrome launched with
#   --remote-debugging-port=9222  (run: python setup_jarvis_chrome.py)
JARVIS_CDP_PORT=9222

# Set to 0 to disable CDP attach entirely (force profile launch)
JARVIS_CDP=1

# Realtime voice: Charon (default), Aoede, Kore, Puck, Zephyr, …
JARVIS_VOICE=Charon

# Gemini Live model override (leave empty for the plugin default):
#   gemini-live-2.5-flash-native-audio | gemini-2.5-flash-native-audio-preview-12-2025
#   gemini-3.1-flash-live-preview
JARVIS_LLM_MODEL=

# ── Gemini intelligence (FULL by default — nothing is disabled) ──
# Thinking is ON by default. Only set a budget if YOU want to trade
# depth for speed: 0 = thinking off (fastest), N = cap at N tokens,
# -1 or empty = Gemini's own default (recommended).
#JARVIS_THINKING_BUDGET=
#JARVIS_TEMPERATURE=

# ── Behaviour: Jarvis waits for YOUR command, never acts by itself ──
# Startup spoken greeting (0 = silent until you speak, 1 = introduce itself)
JARVIS_AUTO_GREETING=0
# Startup warm-up: index = silent cache building only (default, nothing opens)
#                 full  = also pre-launches the browser window
#                 off   = do nothing at startup
JARVIS_PREWARM=index
# Proactive speech (1 = may speak unprompted).
# NOTE: default is NOT sent to Gemini at all (some models reject the field
# with API error 1007). Jarvis never acts by itself regardless — this only
# re-enables Gemini's proactive feature if your model supports it.
JARVIS_PROACTIVITY=0

# Context-window compression (long-session speed). Set 0 if a model rejects it.
JARVIS_CONTEXT_COMPRESSION=1

# ── v4.1 Safety / precision / OCR ──────────────────────────────────────
# Path to tesseract.exe if not on PATH (OCR is optional — UIA works without it)
# e.g. TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# ── Reaction speed (timing only — never affects intelligence) ──
#JARVIS_MIN_ENDPOINTING=0.25
#JARVIS_MAX_ENDPOINTING=4.0
#JARVIS_PREEMPTIVE=1
#JARVIS_SILENCE_MS=300
#JARVIS_PREFIX_MS=20
#JARVIS_END_SENSITIVITY=HIGH
#JARVIS_START_SENSITIVITY=LOW
